<Window x:Class="DocsDR.App.Converter.ConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DocsDR.App.Converter"
        Title="{Binding Title}" Height="900" Width="1480" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- Encabezado: pasos y detección -->
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#30000000">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ProgressBar Width="160" Height="6" Margin="8,0" Maximum="{Binding ProgressMax}" Value="{Binding Progress}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Cancelar" Command="{Binding CancelCommand}" Margin="4,0" Padding="10,4"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="🔎 Detectar tablas en todo el documento" Command="{Binding DetectAllCommand}"
                            Margin="4,0" Padding="12,5" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="{Binding StepText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="520" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Páginas -->
            <ListBox Grid.Column="0" ItemsSource="{Binding PageItems}" SelectedItem="{Binding SelectedPage}"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type conv:ConverterPageItem}">
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#FF1E6FD9" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Página + edición manual -->
            <DockPanel Grid.Column="1">
                <StackPanel DockPanel.Dock="Top" Margin="8,6">
                    <WrapPanel>
                        <RadioButton GroupName="mode" Style="{StaticResource {x:Type ToggleButton}}" Margin="2" Padding="10,4"
                                     IsChecked="{Binding IsSelectMode}" Content="↖ Seleccionar" />
                        <RadioButton GroupName="mode" Style="{StaticResource {x:Type ToggleButton}}" Margin="2" Padding="10,4"
                                     IsChecked="{Binding IsDrawMode}" Content="▭ Dibujar tabla" />
                        <RadioButton GroupName="mode" Style="{StaticResource {x:Type ToggleButton}}" Margin="2" Padding="10,4"
                                     IsChecked="{Binding IsAddColumnMode}" Content="┃ + Columna" />
                        <RadioButton GroupName="mode" Style="{StaticResource {x:Type ToggleButton}}" Margin="2" Padding="10,4"
                                     IsChecked="{Binding IsAddRowMode}" Content="━ + Fila" />
                        <Separator Margin="6,0" />
                        <Button Content="Detectar en esta página" Command="{Binding DetectPageCommand}" Margin="2" Padding="10,4" />
                        <Button Content="🗑 Eliminar tabla" Command="{Binding DeleteSelectedCommand}" Margin="2" Padding="10,4" />
                        <Button Content="Limpiar página" Command="{Binding ClearPageCommand}" Margin="2" Padding="10,4" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ModeHint}" Opacity="0.75" Margin="2,4,0,0" TextWrapping="Wrap" />

                    <!-- Propiedades de la tabla seleccionada -->
                    <Border Margin="0,6,0,0" Padding="8,6" CornerRadius="4" BorderThickness="1" BorderBrush="#30000000"
                            IsEnabled="{Binding HasSelectedTable}">
                        <WrapPanel>
                            <TextBlock Text="{Binding SelectedInfo}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Text="Filas de encabezado:" VerticalAlignment="Center" />
                            <TextBox Width="36" Margin="4,0,16,0" TextAlignment="Center"
                                     Text="{Binding SelectedHeaderRows, UpdateSourceTrigger=LostFocus}" />
                            <CheckBox Content="Filas manuales" IsChecked="{Binding SelectedManualRows}" VerticalAlignment="Center" Margin="0,0,16,0"
                                      ToolTip="Convierte cada renglón en un separador de fila editable (útil si una celda ocupa varios renglones)" />
                            <TextBlock Text="Continuación:" VerticalAlignment="Center" />
                            <ComboBox Width="190" Margin="4,0,16,0" ItemsSource="{x:Static conv:ConverterViewModel.ContinuationModes}"
                                      SelectedIndex="{Binding SelectedContinuationIndex}" />
                            <TextBlock Text="Aplicar a páginas:" VerticalAlignment="Center" />
                            <TextBox Width="90" Margin="4,0" Text="{Binding ApplyPagesText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Ejemplos: 2-5 · 2, 4, 6 · todas" />
                            <Button Content="Aplicar" Command="{Binding ApplyToPagesCommand}" Padding="10,2" />
                        </WrapPanel>
                    </Border>
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Background="{StaticResource ViewerBackground}">
                    <Border Margin="16" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White">
                        <Grid Width="{Binding PageDisplayWidth}" Height="{Binding PageDisplayHeight}">
                            <Image Source="{Binding PageImage}" Stretch="Fill" />
                            <conv:TableOverlay x:Name="Overlay" />
                        </Grid>
                    </Border>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" />

            <!-- Resultado, tipos de columna y exportación -->
            <DockPanel Grid.Column="3" Margin="8">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Vista previa" FontSize="15" FontWeight="SemiBold" />
                    <ComboBox Margin="0,6,0,2" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" DisplayMemberPath="Name" />
                    <TextBlock Text="{Binding SelectedResultInfo}" Opacity="0.75" />
                    <Expander Header="Tipos de columna" Margin="0,6,0,6" IsExpanded="False">
                        <ItemsControl ItemsSource="{Binding ColumnTypes}" Margin="0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type conv:ColumnTypeItem}">
                                    <DockPanel Margin="0,2">
                                        <ComboBox DockPanel.Dock="Right" Width="130"
                                                  ItemsSource="{x:Static conv:ConverterViewModel.ColumnTypeOptions}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Type}" />
                                        <TextBlock Text="{Binding Header}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="Limpieza de datos" FontWeight="SemiBold" />
                    <CheckBox Content="Unir filas partidas (texto en varios renglones)" IsChecked="{Binding MergeWrappedRows}" Margin="0,4,0,0" />
                    <CheckBox Content="Quitar encabezados repetidos" IsChecked="{Binding RemoveRepeatedHeaders}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Separador decimal:" VerticalAlignment="Center" />
                        <ComboBox Width="170" Margin="6,0" ItemsSource="{x:Static conv:ConverterViewModel.DecimalModes}"
                                  SelectedIndex="{Binding DecimalModeIndex}" />
                    </StackPanel>

                    <TextBlock Text="Exportar" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <RadioButton Content="Una hoja por tabla" IsChecked="True" Margin="0,4,0,0" GroupName="sheets" />
                    <RadioButton Content="Todas las tablas en una sola hoja" IsChecked="{Binding Consolidated}" Margin="0,4,0,0" GroupName="sheets" />
                    <CheckBox Content="Incluir hoja «Origen» (páginas de cada tabla)" IsChecked="{Binding IncludeSourceSheet}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="📊 Exportar a Excel" Command="{Binding ExportExcelCommand}" Padding="16,6" FontWeight="SemiBold" />
                        <Button Content="Exportar CSV" Command="{Binding ExportCsvCommand}" Padding="12,6" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Las celdas editadas en la vista previa se exportan tal cual; se pierden si cambias la definición de las tablas."
                               TextWrapping="Wrap" FontSize="11" Opacity="0.65" Margin="0,6,0,0" />
                </StackPanel>

                <DataGrid x:Name="PreviewGrid" ItemsSource="{Binding Preview}" AutoGenerateColumns="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="All"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          AutoGeneratingColumn="OnAutoGeneratingColumn" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
