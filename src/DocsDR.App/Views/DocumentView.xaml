<UserControl x:Class="DocsDR.App.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DocsDR.App.ViewModels"
             xmlns:views="clr-namespace:DocsDR.App.Views"
             x:Name="Root" Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <views:LevelToIndentConverter x:Key="LevelToIndent" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="150" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Panel lateral: miniaturas, marcadores y comentarios -->
        <TabControl Grid.Column="0" Margin="0">
            <TabItem Header="Páginas" ToolTip="Miniaturas: arrastra para reordenar, Ctrl/Mayús para elegir varias">
                <ListBox x:Name="Thumbnails"
                         ItemsSource="{Binding Pages}"
                         SelectionMode="Extended"
                         AllowDrop="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnThumbnailSelectionChanged"
                         PreviewMouseLeftButtonDown="OnThumbnailMouseDown"
                         PreviewMouseMove="OnThumbnailMouseMove"
                         PreviewMouseLeftButtonUp="OnThumbnailClick"
                         DragOver="OnThumbnailDragOver"
                         Drop="OnThumbnailDrop">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Rotar a la izquierda" Command="{Binding RotateLeftCommand}" />
                            <MenuItem Header="Rotar a la derecha" Command="{Binding RotateRightCommand}" />
                            <Separator />
                            <MenuItem Header="Insertar página en blanco" Command="{Binding InsertBlankPageCommand}" />
                            <MenuItem Header="Insertar desde PDF…" Command="{Binding InsertFromPdfCommand}" />
                            <MenuItem Header="Extraer páginas…" Command="{Binding ExtractPagesCommand}" />
                            <Separator />
                            <MenuItem Header="Eliminar páginas" Command="{Binding DeletePagesCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PageViewModel}">
                            <StackPanel Margin="4" HorizontalAlignment="Center" Background="Transparent">
                                <Border Background="White" BorderBrush="#40000000" BorderThickness="1"
                                        Width="{Binding ThumbWidth}" Height="{Binding ThumbHeight}">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="Índice" ToolTip="Marcadores del documento">
                <Grid>
                    <ListBox ItemsSource="{Binding Outline}" PreviewMouseLeftButtonUp="OnOutlineClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           Margin="{Binding Level, Converter={StaticResource LevelToIndent}}"
                                           ToolTip="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Este documento no tiene marcadores." Margin="12" TextWrapping="Wrap" Opacity="0.7">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOutline}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>

            <TabItem Header="Notas" ToolTip="Comentarios y anotaciones">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4">
                        <Button Content="Editar texto" Command="{Binding EditSelectedAnnotationTextCommand}" Padding="8,3" Margin="0,0,6,0" />
                        <Button Content="Eliminar" Command="{Binding DeleteSelectedAnnotationCommand}" Padding="8,3" />
                    </StackPanel>
                    <Grid>
                        <ListBox ItemsSource="{Binding Annotations}" SelectedItem="{Binding SelectedAnnotationItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AnnotationItem}">
                                    <StackPanel Margin="2,3">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Author}" FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Aún no hay comentarios ni anotaciones." Margin="12" TextWrapping="Wrap" Opacity="0.7"
                                   VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAnnotations}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

        <!-- Visor de páginas (virtualizado, desplazamiento por píxel) -->
        <ItemsControl x:Name="PagesHost" Grid.Column="2"
                      ItemsSource="{Binding Pages}"
                      Background="{StaticResource ViewerBackground}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      PreviewMouseWheel="OnMouseWheel"
                      SizeChanged="OnViewerSizeChanged">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer x:Name="Scroll" CanContentScroll="True" Focusable="True"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="{TemplateBinding Background}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PageViewModel}">
                    <Border Margin="0,8" HorizontalAlignment="Center" Background="White">
                        <Grid Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}"
                              Background="Transparent" Tag="{Binding}"
                              MouseLeftButtonDown="OnPageMouseDown"
                              MouseMove="OnPageMouseMove"
                              MouseLeftButtonUp="OnPageMouseUp">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copiar" InputGestureText="Ctrl+C" Click="OnCopyClick" />
                                    <MenuItem Header="Seleccionar todo el texto de la página" InputGestureText="Ctrl+A" Click="OnSelectAllClick" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Image Source="{Binding Image}" Stretch="Fill" />
                            <ItemsControl ItemsSource="{Binding Highlights}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                                   Fill="{StaticResource HighlightBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Selection}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                                   Fill="{StaticResource SelectionBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Contorno de la anotación seleccionada -->
                            <ItemsControl ItemsSource="{Binding AnnotationSelection}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                                   Stroke="#FF1E6FD9" StrokeThickness="1.5" StrokeDashArray="4 3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Asas de esquina para redimensionar imágenes -->
                            <ItemsControl ItemsSource="{Binding Handles}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                                   Fill="White" Stroke="#FF1E6FD9" StrokeThickness="1.5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Vista previa mientras se dibuja -->
                            <Canvas x:Name="DrawLayer" IsHitTestVisible="False" ClipToBounds="True" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
